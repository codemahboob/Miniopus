# Resend (order emails) — all three go in Vercel → Settings → Environment Variables
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
TO_EMAIL=you@example.com
# Use onboarding@resend.dev while testing; a verified-domain address in production
FROM_EMAIL=onboarding@resend.dev

# Optional sales dashboard (Supabase project)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ADMIN_DASHBOARD_PASSWORD=use-a-long-unique-password

# Razorpay online payments (configure these manually in Vercel → Settings → Environment Variables)
# Use TEST keys while testing, then switch to LIVE keys before launch.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
